APP_ENV=local
DATABASE_URL=postgresql+psycopg://streamforge:streamforge@postgres:5432/streamforge
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=commerce.orders.v1
KAFKA_DLQ_TOPIC=commerce.orders.dlq.v1
KAFKA_GROUP_ID=streamforge-consumer
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=eu-central-1
S3_BUCKET_BRONZE=streamforge-bronze
S3_BUCKET_SILVER=streamforge-silver
ANOMALY_AMOUNT_THRESHOLD=5000
ANOMALY_QUANTITY_THRESHOLD=100
BATCH_SIZE=100
BATCH_FLUSH_SECONDS=5
